<div class="card form-card">
  <h2><%= editing ? 'Editar Médico' : 'Cadastrar Médico' %></h2>

  <p class="subtitle form-subtitle">Cadastre os dados profissionais e de contato. Campos com * são obrigatórios.</p>

  <% if (errors.geral) { %>
    <p class="error"><%= errors.geral %></p>
  <% } %>

  <form method="post" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-group">
      <label for="nome">Nome completo*</label>
      <input type="text" id="nome" name="nome" required maxlength="150" autocomplete="name" value="<%= form.nome || '' %>" />
      <% if (errors.nome) { %><span class="error"><%= errors.nome %></span><% } %>
    </div>

    <div class="form-group">
      <label for="crm">CRM*</label>
      <input type="text" id="crm" name="crm" required value="<%= form.crm || '' %>" />
      <% if (errors.crm) { %><span class="error"><%= errors.crm %></span><% } %>
    </div>

    <div class="form-group">
      <label for="especialidade">Especialidade*</label>
      <input type="text" id="especialidade" name="especialidade" required value="<%= form.especialidade || '' %>" />
      <% if (errors.especialidade) { %><span class="error"><%= errors.especialidade %></span><% } %>
    </div>

    <div class="form-group">
      <label for="telefone">Telefone</label>
      <input type="text" id="telefone" name="telefone" autocomplete="tel" value="<%= form.telefone || '' %>" />
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" value="<%= form.email || '' %>" />
    </div>

    <div class="form-group">
      <label for="disponibilidade">Disponibilidade</label>
      <input type="text" id="disponibilidade" name="disponibilidade" value="<%= form.disponibilidade || '' %>" />
    </div>

    <div class="form-actions"><button class="btn" type="submit"><%= editing ? 'Salvar alterações' : 'Cadastrar' %></button>
    <a href="/medicos" class="btn outline">Cancelar</a></div>
  </form>
</div>
