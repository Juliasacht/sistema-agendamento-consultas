<div class="card">
  <h2><%= editing ? 'Editar Consulta' : 'Agendar Consulta' %></h2>

  <% if (errors.geral) { %>
    <p class="error"><%= errors.geral %></p>
  <% } %>

  <p class="subtitle">Cada consulta reserva <%= durationMinutes %> minutos. Consultas agendadas e confirmadas não podem se sobrepor para o mesmo médico ou paciente.</p>
  <p class="subtitle">O status Cancelada libera o horário e mantém o registro. Para reativar, escolha Agendada ou Confirmada. Consultas finalizadas permitem editar apenas observações.</p>

  <% if (!pacientes.length || !medicos.length) { %>
    <div class="notice" role="status">
      <p>Para agendar, cadastre primeiro os registros que faltam:</p>
      <% if (!pacientes.length) { %><a href="/pacientes/novo" class="btn outline">Cadastrar paciente</a><% } %>
      <% if (!medicos.length) { %><a href="/medicos/novo" class="btn outline">Cadastrar médico</a><% } %>
    </div>
  <% } %>
  <form method="post" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-group">
      <label for="data">Data*</label>
      <input type="date" id="data" name="data" required value="<%= form.data || '' %>" />
      <% if (errors.data) { %><span class="error"><%= errors.data %></span><% } %>
    </div>

    <div class="form-group">
      <label for="horario">Horário*</label>
      <input type="time" id="horario" name="horario" required value="<%= form.horario || '' %>" />
      <% if (errors.horario) { %><span class="error"><%= errors.horario %></span><% } %>
    </div>

    <div class="form-group">
      <label for="status">Status</label>
      <select id="status" name="status">
        <% const statusOptions = ['Agendada', 'Confirmada', 'Realizada', 'Cancelada', 'Não Compareceu']; %>

        <% statusOptions.forEach(s => { %>
          <option value="<%= s %>" <%= (form.status || 'Agendada') === s ? 'selected' : '' %>>
            <%= s %>
          </option>
        <% }) %>
      </select>
      <% if (errors.status) { %><span class="error"><%= errors.status %></span><% } %>
    </div>

    <div class="form-group">
      <label for="idPaciente">Paciente*</label>
      <select id="idPaciente" name="idPaciente" required>
        <option value="">Selecione</option>
        <% pacientes.forEach(p => { %>
          <option value="<%= p.idPaciente %>" <%= String(form.idPaciente) === String(p.idPaciente) ? 'selected' : '' %>>
            <%= p.nome %>
          </option>
        <% }) %>
      </select>
      <% if (errors.idPaciente) { %><span class="error"><%= errors.idPaciente %></span><% } %>
    </div>

    <div class="form-group">
      <label for="idMedico">Médico*</label>
      <select id="idMedico" name="idMedico" required>
        <option value="">Selecione</option>
        <% medicos.forEach(m => { %>
          <option value="<%= m.idMedico %>" <%= String(form.idMedico) === String(m.idMedico) ? 'selected' : '' %>>
            <%= m.nome %> - <%= m.especialidade %>
          </option>
        <% }) %>
      </select>
      <% if (errors.idMedico) { %><span class="error"><%= errors.idMedico %></span><% } %>
    </div>

    <div class="form-group">
      <label for="observacoes">Observações</label>
      <textarea id="observacoes" name="observacoes" maxlength="5000"><%= form.observacoes || '' %></textarea>
      <% if (errors.observacoes) { %><span class="error"><%= errors.observacoes %></span><% } %>
    </div>

    <button class="btn" type="submit" <%= !pacientes.length || !medicos.length ? 'disabled' : '' %>><%= editing ? 'Salvar alterações' : 'Agendar' %></button>
    <a href="/consultas" class="btn outline">Voltar à agenda</a>
  </form>
</div>
