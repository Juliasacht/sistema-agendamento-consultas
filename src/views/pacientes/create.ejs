<div class="card form-card">
  <h2><%= editing ? 'Editar Paciente' : 'Cadastrar Paciente' %></h2>

  <p class="subtitle form-subtitle">Mantenha os dados do paciente organizados e atualizados. Campos com * são obrigatórios.</p>

  <% if (errors.geral) { %>
    <p class="error"><%= errors.geral %></p>
  <% } %>

  <form method="post" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="form-group">
      <label for="nome">Nome completo*</label>
      <input type="text" id="nome" name="nome" required maxlength="150" autocomplete="name" value="<%= form.nome || '' %>" />
      <% if (errors.nome) { %><span class="error"><%= errors.nome %></span><% } %>
    </div>

    <div class="form-group">
      <label for="cpf">CPF</label>
      <input type="text" id="cpf" name="cpf" value="<%= form.cpf || '' %>" />
    </div>

    <div class="form-group">
      <label for="dataNascimento">Data de Nascimento</label>
      <input type="date" id="dataNascimento" name="dataNascimento" value="<%= form.dataNascimento || '' %>" />
    </div>

    <div class="form-group">
      <label for="telefone">Telefone</label>
      <input type="text" id="telefone" name="telefone" autocomplete="tel" value="<%= form.telefone || '' %>" />
    </div>

    <div class="form-group">
      <label for="endereco">Endereço</label>
      <input type="text" id="endereco" name="endereco" value="<%= form.endereco || '' %>" />
    </div>

    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" value="<%= form.email || '' %>" />
    </div>

    <div class="form-actions"><button class="btn" type="submit"><%= editing ? 'Salvar alterações' : 'Cadastrar' %></button>
    <a href="/pacientes" class="btn outline">Cancelar</a></div>
  </form>
</div>
