# Copie para .env.demo e preencha suas credenciais do MySQL.
APP_PORT=3000
APP_HOST=127.0.0.1
SESSION_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=clinica_demo
# Escolha uma senha de 12 a 128 caracteres para o login demo.admin.
DEMO_ADMIN_PASSWORD=
# Opcional: caminho completo de mysqld.exe para iniciar uma instancia ja
# inicializada em .demo/mysql. Deixe vazio ao usar seu servico MySQL normal.
DEMO_MYSQL_BIN=
